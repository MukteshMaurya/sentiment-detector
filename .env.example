# ------------------------------------------------------------------
# AI Sentiment Detector — environment variable reference
# Copy to the appropriate platform instead of committing real values.
# Never commit real .env files.
# ------------------------------------------------------------------

# --------------------------- Backend (Render) -------------------------------
# The Vercel frontend origin. Recommended: set to your production Vercel URL.
# When set, it is added to the allowed CORS origins.
FRONTEND_URL=https://sentiment-detector-tau.vercel.app

# Optional: fully override the comma-separated CORS origin list
# (defaults cover localhost:3000/8000 + the production Vercel URL above).
# SENTIMENT_CORS_ORIGINS=http://localhost:3000,https://your-vercel-domain.example

# Optional model/API tuning (all have safe defaults)
# SENTIMENT_MODEL_DIR=app/model_assets        # relative to the backend/ dir
# SENTIMENT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest (ONNX int8)
# SENTIMENT_MAX_INPUT_CHARS=2000
# SENTIMENT_MAX_TOKENS=256
# SENTIMENT_LOG_LEVEL=INFO

# ------------------- Hindi / Hinglish translation (backend) ----------------
# Devanagari Hindi and Romanized Hinglish are translated to English with
# Helsinki-NLP/opus-mt-hi-en (ONNX fp16) before sentiment analysis. English
# input skips this entirely, so these assets are never loaded for it.

# Master switch. Set to 0/false/no/off to disable detection + translation.
# TRANSLATION_ENABLED=1

# TRANSLATION_MODEL_DIR=app/translation_assets  # relative to the backend/ dir
# TRANSLATION_MODEL_NAME=Helsinki-NLP/opus-mt-hi-en (ONNX fp16)
# TRANSLATION_MAX_SOURCE_TOKENS=256
# TRANSLATION_MAX_NEW_TOKENS=128

# --------------------------- Frontend (Vercel) ------------------------------
# Base URL of the Render backend. Injected at build time by frontend/build.js
# into frontend/api-config.js. MUST be set in the Vercel project environment
# for production/preview or the frontend will call http://localhost:8000.
VITE_API_URL=https://your-render-service.onrender.com