# Large ONNX model artifacts are stored with Git LFS so the repository
# stays cloneable on GitHub (files >100MB are rejected without LFS).
# Install Git LFS before pushing: https://git-lfs.com
backend/app/model_assets/*.onnx filter=lfs diff=lfs merge=lfs -text
backend/app/model_assets/model.onnx filter=lfs diff=lfs merge=lfs -text
