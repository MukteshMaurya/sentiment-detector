# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Model artifacts (large files; commit only app/model_assets/ via Git LFS,
# now under backend/app/model_assets/; see .gitattributes).
# Cached/downloading model sources are ignored (any directory level):
.model_cache/
*.pt
*.bin
*.onnx.tmp

# Evaluation outputs (regenerated by backend/scripts/evaluate_model.py)
dataset/
data/*.log

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Hugging Face cache
.cache/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Vercel
.vercel/

# Frontend build artifact (generated by frontend/build.js from VITE_API_URL)
frontend/api-config.js
