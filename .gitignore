# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# Environment files (never commit secrets)
.env
.env.*

# Model artifacts (large files; commit only app/model_assets/ via Git LFS)
# NOTE: app/model_assets/*.onnx is tracked via Git LFS (.gitattributes).
# Cached/downloading model sources are ignored:
scripts/.model_cache/
*.pt
*.bin
*.onnx.tmp

# Evaluation outputs (regenerated by scripts/evaluate_model.py)
data/dataset/
data/*.log

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Hugging Face cache
.cache/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Vercel
.vercel/
